# Copy to .env (git-ignored). Placeholders only: never commit real secrets.

# Local dev database from docker-compose.dev.yml
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/icrm

# Static API token, at least 16 characters. Generate your own:
#   node -e "console.log(crypto.randomUUID())"
ICRM_API_TOKEN=change-me-to-a-long-random-token

# Directory with the YAML config. `pnpm --filter @icrm/server dev` defaults to <repo>/config.
# Required for any other way of starting the server (built dist, Docker): use an absolute path,
# or a path relative to the working directory the server is started from.
# ICRM_CONFIG_DIR=/absolute/path/to/icrm/config

# HOST=127.0.0.1
# PORT=3100
